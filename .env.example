PULSE_APP__NAME=Pulse
PULSE_APP__VERSION=0.1.0
PULSE_APP__ENVIRONMENT=dev
PULSE_APP__DEBUG=true
PULSE_APP__TIMEZONE=UTC
PULSE_APP__ALLOWED_ORIGINS=["*"]

PULSE_API__HOST=0.0.0.0
PULSE_API__PORT=9000

PULSE_DATABASE__DRIVER="postgresql+asyncpg"
PULSE_DATABASE__HOST="localhost"
PULSE_DATABASE__USERNAME="postgres"
PULSE_DATABASE__PASSWORD="postgres"
PULSE_DATABASE__DB="pulsedb"
PULSE_DATABASE__PORT="5423"
PULSE_DATABASE__ECHO=false
PULSE_DATABASE__POOL_SIZE=10
PULSE_DATABASE__MAX_OVERFLOW=20
PULSE_DATABASE__POOL_TIMEOUT=30
PULSE_DATABASE__POOL_RECYCLE=1800
PULSE_DATABASE__POOL_PRE_PING=true

PULSE_REDIS__HOST=localhost
PULSE_REDIS__PORT=6380
PULSE_REDIS__DB=0
# PULSE_REDIS__PASSWORD=

# Maps an ingress API key to the tenant UUID it authenticates.
PULSE_SECURITY__INGRESS_API_KEYS={"dev-key": "00000000-0000-0000-0000-000000000001"}
# Encrypts provider secrets at rest. Generate: python -c "from services.secrets import generate_key; print(generate_key())"
PULSE_SECURITY__SECRETS_KEY=

# console | smtp
PULSE_EMAIL__DRIVER=console
PULSE_EMAIL__FROM_ADDRESS=pulse@localhost
# PULSE_EMAIL__SMTP_HOST=
# PULSE_EMAIL__SMTP_PORT=587
# PULSE_EMAIL__SMTP_USERNAME=
# PULSE_EMAIL__SMTP_PASSWORD=
# PULSE_EMAIL__SMTP_USE_TLS=true

# Event ingress limits per tenant (platform admins can override per tenant in the console)
# PULSE_RATE_LIMIT__ENABLED=true
# PULSE_RATE_LIMIT__DEFAULT_RATE_PER_SECOND=50
# PULSE_RATE_LIMIT__DEFAULT_BURST=100
# PULSE_RATE_LIMIT__DEFAULT_DAILY_QUOTA=100000

PULSE_OUTBOX__POLL_INTERVAL_SECONDS=1.0
PULSE_OUTBOX__BATCH_SIZE=100

# console | fcm
PULSE_PUSH__DRIVER=console
# PULSE_PUSH__FCM_CREDENTIALS_PATH=/path/to/service-account.json

PULSE_RETRY__MAX_ATTEMPTS=3
PULSE_RETRY__BASE_DELAY_SECONDS=5.0
PULSE_RETRY__MAX_DELAY_SECONDS=300.0

# Reconciliation sweep: per-channel sent->confirmed TTLs (seconds)
PULSE_RECONCILIATION__INTERVAL_SECONDS=30.0
# PULSE_RECONCILIATION__SSE_TTL_SECONDS=120
# PULSE_RECONCILIATION__PUSH_TTL_SECONDS=300
# PULSE_RECONCILIATION__SMS_TTL_SECONDS=900
# PULSE_RECONCILIATION__EMAIL_TTL_SECONDS=3600

# Maps a webhook provider slug to its HMAC signing secret.
PULSE_WEBHOOK__SECRETS={"console": "dev-webhook-secret"}

PULSE_LOGGING__LEVEL=INFO
PULSE_LOGGING__JSON=true
PULSE_LOGGING__COLOR=false
PULSE_LOGGING__INCLUDE_TIMESTAMP=true

# Sentinel user/tenant service (contract: docs/sentinel-contract.md). Unset = recipients from the payload / local table only.
# PULSE_SENTINEL__BASE_URL=https://sentinel.internal
# PULSE_SENTINEL__TOKEN=
# PULSE_SENTINEL__CACHE_TTL_SECONDS=60
